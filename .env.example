# BrewMap settings. Copy to .env for local development; set the same names in
# Vercel → Project → Settings → Environment Variables for deployments.
# Nothing here is sent to the browser except names that start with VITE_.

# --- AI providers (ADR-03). OpenAI-compatible endpoints, open-weight models only (D7). ---
AI_PROVIDER_NAME=primary
AI_BASE_URL=
AI_API_KEY=
AI_SCAN_MODEL=
AI_RECIPE_MODEL=
# US$ per million tokens, for the spend cap. Set from the provider's price list.
AI_PRICE_IN_PER_M=0.3
AI_PRICE_OUT_PER_M=1.2

# Optional failover provider, tried when the primary fails.
AI_FALLBACK_PROVIDER_NAME=fallback
AI_FALLBACK_BASE_URL=
AI_FALLBACK_API_KEY=
AI_FALLBACK_SCAN_MODEL=
AI_FALLBACK_RECIPE_MODEL=

# Legacy Groq setup, used last until the migration (ADR-09). Server-side only:
# the old VITE_GROQ_API_KEY is no longer read and should be deleted.
GROQ_API_KEY=
# AI_DISABLE_LEGACY_GROQ=true

# --- Abuse and spend protection (ADR-06). Required in production. ---
TURNSTILE_SECRET_KEY=
VITE_TURNSTILE_SITE_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
AI_MONTHLY_CAP_USD=20
# Optional: a Slack-compatible webhook for spend alerts at 50%, 80% and 100%.
ALERT_WEBHOOK_URL=
# Only to run AI in production without Turnstile and Upstash, on purpose.
# ALLOW_UNPROTECTED_AI=true

# --- Evals ---
# EVAL_PHOTOS_DIR=/path/to/private/label-photos
